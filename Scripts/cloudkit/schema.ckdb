DEFINE SCHEMA

    // QuotaKit Mac-to-iPhone records. Keep these definitions alongside the
    // opt-in Mac fleet records below: importing a partial schema can remove
    // indexes from fields omitted by a later schema update.
    RECORD TYPE DeviceSnapshot (
        "___recordID"   REFERENCE QUERYABLE,
        deviceName      STRING,
        deviceID        STRING,
        appVersion      STRING,
        syncTimestamp   TIMESTAMP,
        payload         BYTES,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_creator"
    );

    RECORD TYPE DeviceProviderSnapshot (
        "___recordID"   REFERENCE QUERYABLE,
        deviceID        STRING QUERYABLE,
        deviceName      STRING,
        providerID      STRING,
        providerName    STRING,
        accountEmail    STRING,
        lastUpdated     TIMESTAMP,
        encodingVersion INT64,
        payload         BYTES,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_creator"
    );

    RECORD TYPE ProviderAccountLinkage (
        "___recordID"          REFERENCE QUERYABLE,
        providerID             STRING,
        linkedIdentifiers      LIST<STRING>,
        confirmedAt            TIMESTAMP,
        confirmedFromDeviceID  STRING,
        unmerge                INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_creator"
    );

    RECORD TYPE QuotaTransition (
        providerName       STRING,
        providerID         STRING,
        state              STRING,
        transitionAt       TIMESTAMP,
        deviceID           STRING,
        accountEmail       STRING,
        windowDisplayLabel STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_creator"
    );

    // Opt-in Mac fleet sync records. These use the QuotaKitMacFleetSync zone
    // in the same Columbus Labs container as the mobile records above.
    RECORD TYPE AccountSnapshot (
        accountKey       STRING,
        deviceID         STRING,
        fetchedAt        TIMESTAMP,
        provider         STRING,
        schemaVersion    INT64,
        displayLabel     ENCRYPTED STRING,
        usagePayload     ENCRYPTED STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_creator"
    );

    RECORD TYPE Device (
        appVersion       STRING,
        deviceID         STRING,
        hostName         STRING,
        lastSeen         TIMESTAMP,
        model            STRING,
        schemaVersion    INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_creator"
    );

    RECORD TYPE Preferences (
        editCount        INT64,
        modifiedAt       TIMESTAMP,
        payload          STRING,
        schemaVersion    INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_creator"
    );

    RECORD TYPE ProviderIntent (
        editCount        INT64,
        modifiedAt       TIMESTAMP,
        payload          STRING,
        provider         STRING,
        schemaVersion    INT64,
        apiKey           ENCRYPTED STRING,
        cookieHeader     ENCRYPTED STRING,
        secretKey        ENCRYPTED STRING,
        tokenAccounts    ENCRYPTED STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_creator"
    );
